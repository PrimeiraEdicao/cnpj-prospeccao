# Streamlit Community Cloud: Manage app > Settings > Secrets.
# Nunca coloque credenciais no repositório nem no chat.
APP_ENV = "production"
AUTH_MODE = "supabase"
SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_PREENCHA"
ALLOW_SIGNUP = "true"
# Opcional: cargas da Receita, disponíveis somente para administradores.
# GITHUB_DATA_TOKEN = "TOKEN_FINE_GRAINED_ACTIONS_WRITE_CONTENTS_READ"
GITHUB_DATA_REPOSITORY = "PrimeiraEdicao/cnpj-prospeccao"
GITHUB_DATA_BRANCH = "main"
# Aplique a migração e configure Auth/templates/SMTP conforme docs/DEPLOY.md.
