# Escopo atual vindo do notebook original
TARGET_UF=MG
TARGET_MUNICIPIO_CODE=4553

# Banco de estado de contatos. Local por padrão.
# Em Streamlit Cloud, use um PostgreSQL persistente (Supabase/Neon/etc.).
DATABASE_URL=sqlite:///data/contact_state.db

# Opcional: fixa uma competência da Receita, ex.: 2026-09.
# Se vazio, o ETL descobre a competência mais recente publicada.
RECEITA_RELEASE=

# Tamanho dos chunks de leitura CSV
CSV_CHUNK_SIZE=250000

# Apresentação e mensagem padrão deste projeto (também podem ser editadas no app).
CONTACT_SENDER=Daniel do Sebrae
CONTACT_TEMPLATE="{saudacao}! Tudo bem? Sou {remetente}. Nesse contato falo com {nome}?"
