# Desenvolvimento local sem login. Nunca use estes dois valores em produção.
APP_ENV=development
AUTH_MODE=disabled

# Escopo atual vindo do notebook original
TARGET_UF=MG
TARGET_MUNICIPIO_CODE=4553

# Banco de estado de contatos. Local por padrão.
# Legado/desenvolvimento. Produção usa SUPABASE_URL e SUPABASE_PUBLISHABLE_KEY.
DATABASE_URL=sqlite:///data/contact_state.db

# Opcional: fixa uma competência da Receita, ex.: 2026-09.
# Se vazio, o ETL descobre a competência mais recente publicada.
RECEITA_RELEASE=

# Tamanho dos chunks de leitura CSV
CSV_CHUNK_SIZE=250000

# Apresentação e mensagem padrão deste projeto (também podem ser editadas no app).
CONTACT_SENDER=Daniel do Sebrae
CONTACT_TEMPLATE="{saudacao}! Tudo bem? Sou {remetente}. Nesse contato falo com {nome}?"

# Token fine-grained restrito a este repositório: Actions e Contents com leitura/escrita.
# Produção Supabase: apenas cargas; Contents:read é suficiente.
# Desenvolvimento legado sem Auth: Contents:write também é necessário para histórico.
GITHUB_DATA_TOKEN=
GITHUB_DATA_REPOSITORY=PrimeiraEdicao/cnpj-prospeccao
GITHUB_DATA_BRANCH=main
# Opcional: chave para restringir o botão de atualização durante os testes.
DATA_UPDATE_ADMIN_KEY=

# Produção: veja .env.production.example e docs/DEPLOY.md.
