# Domínio sem protocolo. DNS A/AAAA deve apontar para o servidor.
APP_DOMAIN=prospeccao.seudominio.com.br
APP_IMAGE=cnpj-prospeccao:local
APP_ENV=production
AUTH_MODE=supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_PREENCHA
ALLOW_SIGNUP=true
# Opcional: somente administradores poderão disparar cargas.
# Token fine-grained restrito ao repositório, Actions:write e Contents:read.
GITHUB_DATA_TOKEN=
GITHUB_DATA_REPOSITORY=PrimeiraEdicao/cnpj-prospeccao
GITHUB_DATA_BRANCH=main
CONTACT_SENDER=
CONTACT_TEMPLATE="{saudacao}! Tudo bem? Sou {remetente}. Nesse contato falo com {nome}?"
